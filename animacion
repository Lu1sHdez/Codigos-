<style>
  /* Contenedor principal */
  .dn-custom-loader-container {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 80px 0; 
  }
  
  /* El carril gris con BORDE */
  .dn-progress-track {
    position: relative;
    width: 90%; 
    max-width: 1000px; 
    height: 50px; 
    background: #BCBEC3; 
    border-radius: 50px;
    /* Borde gris oscuro para combinar con la tuerca */
    border: 10px solid #444B65;
    box-sizing: border-box; /* Asegura que el borde no ensanche la barra */
  }
  
  /* Contenedor para recortar la barra verde */
  .dn-progress-fill-container {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 46px; /* Un poco menos que el padre por el borde */
    overflow: hidden;
    left: 0;
    top: 0;
  }
  
  /* Barra verde animada (Limitada al 70%) */
  .dn-progress-fill {
    width: 100%;
    height: 100%;
    background: #A8FF00;
    position: absolute;
    left: 0;
    top: 0;
    animation: fillMoveTo70 2.5s ease-in-out infinite alternate;
  }
  
  /* Tuerca */
  .dn-gear-icon {
    position: absolute;
    top: 50%;
    width: 100px; 
    height: auto;
    z-index: 10;
    filter: drop-shadow(0px 4px 10px rgba(0,0,0,0.2));
    animation: gearMoveTo70 2.5s ease-in-out infinite alternate;
  }
  
  /* Animación de la barra: de -100% a -30% (70% llena) */
  @keyframes fillMoveTo70 {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(-30%);
    }
  }
  
  /* Animación de la tuerca: de 0% a 70% con 1 vuelta */
  @keyframes gearMoveTo70 {
    from {
      left: 0%;
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      left: 70%;
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  </style>
  
  <div class="dn-custom-loader-container">
    <div class="dn-progress-track">
      <div class="dn-progress-fill-container">
        <div class="dn-progress-fill"></div>
      </div>
      <img src="https://dominum.app/wp-content/uploads/2026/03/Gear-handle.svg" class="dn-gear-icon" alt="Gear">
    </div>
  </div>
